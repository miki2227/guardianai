1794783176.578992 execve("/guardian/notify-launch", ["/guardian/notify-launch", "python3", "-c", "import ast,hashlib,json,pathlib,zipfile\nroot=pathlib.Path('/workspace/source')\nout=pathlib.Path('/output'); out.mkdir(exist_ok=True)\nnl=chr(10)\nkw=('observe','stop','publish','handoff','release','review')\nmods=[]; locs=[]\nfor p in sorted(root.rglob('*')):\n if p.suffix not in {'.py','.c'} or 'incoming' in p.parts: continue\n b=p.read_bytes(); rel=p.relative_to(root).as_posix()\n mods.append({'path':rel,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})\n if p.suffix!='.py': continue\n tree=ast.parse(b.decode())\n def walk(nodes, cls=None):\n  for n in nodes:\n   if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):\n    q=n.name if cls is None else cls+'.'+n.name\n    if n.name=='main' or any(k in n.name.lower() for k in kw):\n     locs.append({'symbol':q,'file':rel,'line':n.lineno})\n    if isinstance(n, ast.ClassDef): walk(n.body, n.name)\n   elif isinstance(n, ast.If):\n    te=n.test\n    if isinstance(te, ast.Compare) and any(isinstance(x, ast.Constant) and x.value=='__main__' for x in te.comparator"...], 0x5a7b6b8f5f20 /* 4 vars */) = 0
