1794831754.018379 write(1</home/pratz/guardianai-checkstyle-paired-v2/investigation/session/evidence/step-001/stdout.txt>, "\n 209|    }\n 210|\n 211|    /**\n 212|     * Calculates the hashcode for the serializable object based on its content.\n 213|     *\n 214|     * @param object serializable object.\n 215|     * @return the hashcode for serializable object.\n 216|     * @throws IllegalStateException when some unexpected happened.\n 217|     */\n 218|    private static String getHashCodeBasedOnObjectContent(Serializable object) {\n 219|        try {\n 220|            final ByteArrayOutputStream outputStream = new ByteArrayOutputStream();\n 221|            // in-memory serialization of Configuration\n 222|            serialize(object, outputStream);\n 223|            // Instead of hexEncoding outputStream.toByteArray() directly we\n 224|            // use a message digest here to keep the length of the\n 225|            // hashcode reasonable\n 226|\n 227|            final MessageDigest digest = MessageDigest.getInstance(\"SHA-1\");\n 228|            digest.update(outputStream.toByteArray());\n 229|\n 230|            return new BigInteger(1, digest.di"..., 8074) = 8074
