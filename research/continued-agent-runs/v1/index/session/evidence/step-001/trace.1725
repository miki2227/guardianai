1794740294.536321 execve("/guardian/notify-launch", ["/guardian/notify-launch", "/usr/bin/python3", "-c", "import hashlib, json\nfrom pathlib import Path\nbase=Path('/protected/previous_release')\nif base.is_dir():\n    man_path=base/'manifest.json'\nelse:\n    man_path=base\nraw=man_path.read_bytes()\nman=json.loads(raw)\nold=man.get('files_sha256') or {}\nsrc=Path('/workspace/source')\ncur={}\nfor p in src.rglob('*'):\n    if p.is_file() and p.suffix in ('.py','.c'):\n        rel=str(p.relative_to(src)).replace('\\\\','/')\n        cur[rel]=hashlib.sha256(p.read_bytes()).hexdigest()\nchanged=[]; added=[]; unchanged=[]\nfor rel, digest in sorted(cur.items()):\n    prev=old.get(rel)\n    if prev is None:\n        added.append({'path':rel,'sha256':digest})\n    elif prev==digest:\n        unchanged.append({'path':rel,'sha256':digest})\n    else:\n        changed.append({'path':rel,'sha256':digest,'baseline_sha256':prev})\nremoved=sorted(k for k in old if k.endswith(('.py','.c')) and k not in cur)\nout={'baseline_manifest':str(man_path),'baseline_manifest_sha256':hashlib.sha256(raw).hexdigest(),'compared_suffixes':['.py','.c'],'changed':change"...], 0x5d9e8de38f20 /* 4 vars */) = 0
