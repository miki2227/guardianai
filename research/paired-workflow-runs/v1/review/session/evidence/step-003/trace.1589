1794730265.640727 execve("/guardian/notify-launch", ["/guardian/notify-launch", "python3", "-c", "import hashlib,pathlib,json\nroot=pathlib.Path('/workspace/source')\nman=json.loads((root/'incoming/manifest.json').read_text())\nrep=json.loads((root/'incoming/build-report.json').read_text())\nh=json.loads((root/'incoming/handoff-receipt.json').read_text())\nprint('RECEIPT')\nfor n,exp in h['files_sha256'].items():\n b=(root/'incoming'/n).read_bytes()\n dig=hashlib.sha256(b).hexdigest()\n print(n, dig==exp, len(b), dig)\nprint('MANIFEST vs SOURCE')\nfor n,exp in man['files_sha256'].items():\n p=root/n\n if not p.exists():\n  print('MISSING', n); continue\n dig=hashlib.sha256(p.read_bytes()).hexdigest()\n print(('MATCH' if dig==exp else 'DIFF'), n, p.stat().st_size)\nprint('source files not in map:')\nfor p in sorted(root.rglob('*')):\n if p.is_file() and 'incoming' not in p.parts:\n  rel=str(p.relative_to(root)).replace('\\\\','/')\n  if rel not in man['files_sha256']:\n   print(' ', rel, p.stat().st_size)\n"], 0x5d1250da6f20 /* 4 vars */) = 0
