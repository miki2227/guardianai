1794732713.671800 execve("/guardian/notify-launch", ["/guardian/notify-launch", "python3", "-c", "import hashlib,json,pathlib\nroot=pathlib.Path('/workspace/source')\ninc=root/'incoming'\nprint('INCOMING')\nfor p in sorted(inc.iterdir()):\n b=p.read_bytes(); print(p.name, len(b), hashlib.sha256(b).hexdigest())\nprint('---REPORT---')\nprint((inc/'build-report.json').read_text())\nprint('---HANDOFF---')\nprint((inc/'handoff.md').read_text())\nman=json.loads((inc/'manifest.json').read_text())\nprint('MANIFEST keys', list(man))\nprint('policy', man.get('native_policy'), 'lg', man.get('launch_guard_version'), 'nfiles', len(man.get('files_sha256',{})))\nprint('compiler', man.get('compiler_argv'))\nprint('scope', man.get('scope'))\nfor n,exp in man['files_sha256'].items():\n p=root/n\n if not p.is_file():\n  print('ABSENT', n); continue\n dig=hashlib.sha256(p.read_bytes()).hexdigest()\n print(('MATCH' if dig==exp else 'DIFF'), n, p.stat().st_size)\nprint('EXTRA')\nfor p in sorted(root.rglob('*')):\n if p.is_file() and 'incoming' not in p.parts:\n  rel=p.relative_to(root).as_posix()\n  if rel not in man['files_sha256']:\n   print(rel, p.s"...], 0x5db33e9e2f20 /* 4 vars */) = 0
